# ------------------------------------------------------------------
# Backend environment variables (copy to backend/.env or export).
# NEVER commit .env — only this example is committed.
# ------------------------------------------------------------------

# MySQL connection (peer project: online_pharmacy, created by Flyway)
DB_URL=jdbc:mysql://localhost:3306/online_pharmacy?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=pharmacy
DB_PASSWORD=change-me

# JWT signing secret (base64 or long random string). 256-bit minimum for HS256.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Server (8080 is commonly occupied by other services on this machine)
SERVER_PORT=8081

# CORS allowed origin for the React dev server
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Flyway
FLYWAY_ENABLED=true

# Seed demo data (admin/pharmacist/customers + sample medicines) on startup
APP_SEED_ENABLED=true

# ------------------------------------------------------------------
# Third-party integration placeholders (NOT used yet — no hard-coded keys)
# ------------------------------------------------------------------
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
PAYMENT_API_KEY=
AI_API_KEY=